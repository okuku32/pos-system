# Copy to .env.android and set your live API address. The Android app is a copy of the React front end
# running inside the phone, so it must call the API by its full https address (not /api).
VITE_API_URL=https://kapu.example.com/api
# Push notifications: set to on once google-services.json (from Firebase) is in client/android/app/
VITE_PUSH=off
