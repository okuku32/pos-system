# Dependencies (reinstall with: npm run install-all)
node_modules/

# Secrets: never commit these. Copy the .env.example files instead.
.env
.env.*
!.env.example
!.env.*.example

# Build output
dist/
client/dist/

# Uploaded product pictures (customer/business data)
server/uploads/*
!server/uploads/products/
server/uploads/products/*
!server/uploads/products/.gitkeep

# Logs and OS / editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
~$*

# More secrets: keys, certificates, app signing and cloud credentials (scripts/check-secrets.js blocks them too)
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
*.mobileprovision
keystore.properties
key.properties
**/google-services.json
**/GoogleService-Info.plist
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
credentials*.json
id_rsa*
id_ed25519*
.npmrc
secrets/

# Database files and dumps (customer data)
*.sqlite
*.sqlite3
*.db
*.bson
*.archive
dump/
backup*/

.vercel
.env*
