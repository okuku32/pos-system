PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pos_system
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# ---- M-Pesa Daraja (get these from https://developer.safaricom.co.ke) ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
# Sandbox shortcode & passkey (public test values from Safaricom)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Must be a PUBLIC https URL (use ngrok in development): https://xxxx.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-public-url/api/mpesa/callback

# ---- Customer emails (order placed, payment received, dispatched) ----
# Public address of the shop, used for "Track your order" links in emails
SHOP_URL=http://localhost:5173
MAIL_FROM=Ordersasa <no-reply@ordersasa.co.ke>
# Leave SMTP_HOST empty in development to use a free Ethereal test inbox (preview links appear in the server log).
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Google sign-in (OAuth) ----
# Google Cloud console > APIs & Services > Credentials > Create OAuth client ID (Web application).
# Add http://localhost:5173 (and your public shop URL) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# ---- KRA eTIMS (OSCU) ----
# off | mock (simulated, receipts marked TEST) | sandbox (KRA test system) | live
ETIMS_MODE=mock
ETIMS_TIN=
ETIMS_BHF_ID=00
ETIMS_DEVICE_SERIAL=
ETIMS_TRADER_NAME=Ordersasa
ETIMS_ADDRESS=Imara Mall, Mombasa Road, Nairobi
# Optional overrides (defaults are KRA's published sandbox/live addresses)
# ETIMS_API_URL=
# ETIMS_PORTAL_URL=
# ETIMS_DEFAULT_ITEM_CLASS=5020230500
