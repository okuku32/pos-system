PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pos_system
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# ---- Public addresses ----
# The website's public address: used in email links ("Track your order", "Reply to the message") and the sitemap
SHOP_URL=http://localhost:5173
# Public HTTPS address of this server (e.g. your ngrok URL or domain). M-Pesa results arrive at PUBLIC_API_URL/api/mpesa/callback
PUBLIC_API_URL=https://your-public-url
# true = the server also serves the built website (npm run build in client/), e.g. to share it through ngrok
SERVE_CLIENT=false

# ---- M-Pesa Daraja (https://developer.safaricom.co.ke) ----
# Buyers pay "Buy online" orders to this paybill/till; the marketplace then pays sellers after delivery (minus commission)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
# Sandbox shortcode & passkey (public test values from Safaricom)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ---- Emails (orders, payments, new chats, password resets) ----
MAIL_FROM=Kapu <no-reply@kapu.co.ke>
# Leave SMTP_HOST empty in development to use a free Ethereal test inbox (preview links appear in the server log).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Google sign-in (optional) ----
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web). Add your site under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Marketplace name, contacts, address and commission % are edited in the admin area (/admin → Settings).

# Paying riders & inspection agents by M-Pesa (B2C). Apply to Safaricom for a B2C shortcode; the security credential
# is your initiator password encrypted with Safaricom's certificate (Daraja portal → "Security credential").
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# AI search ("cheapest Samsung phone under 20k"): Claude reads the question. Without a key, a built-in parser is used.
# Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# ---- Security
# Secret part of the M-Pesa callback addresses (24+ random characters). Without it one is derived from JWT_SECRET.
MPESA_CALLBACK_SECRET=
# Extra sites allowed to call the API from a browser (comma-separated), besides CLIENT_URL / SHOP_URL / PUBLIC_API_URL
CORS_ORIGINS=
# Force the Secure flag on login cookies (automatic behind HTTPS / ngrok)
COOKIE_SECURE=
# Logins / sign-ups / resets per IP per 15 minutes (default 20)
AUTH_RATE_LIMIT=

# Several servers behind a load balancer: share cache, rate limits, live updates and presence (optional)
# REDIS_URL=redis://localhost:6379

# Origins the Android app (Capacitor) calls the API from. Default: https://localhost,capacitor://localhost. "off" removes them.
# APP_ORIGINS=https://localhost,capacitor://localhost

# Push notifications to the Android app (Firebase Cloud Messaging). The service-account JSON stays on the server only.
# FIREBASE_SERVICE_ACCOUNT_FILE=/secure/path/firebase-service-account.json

# Split payments: sellers' own M-Pesa (Daraja) keys are stored encrypted with this key (64 hex characters,
# e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"). If unset, a key is
# derived from JWT_SECRET. Changing it later means sellers must connect their M-Pesa prompts again.
PAY_SECRETS_KEY=

# Photos through a CDN (faster everywhere, less load on this server). Create a "pull zone" on your CDN whose origin is
# this server (e.g. https://kapu.example.com); photo addresses then start with IMAGE_CDN_URL. https only. Empty = served from here.
IMAGE_CDN_URL=
# Optional: the CDN's own resizing, so ad cards download small photos. {w} = width; {url} = the photo on the CDN, {path} = /uploads/...
#   Cloudflare (Images enabled on the zone): https://cdn.example.com/cdn-cgi/image/width={w},format=auto,quality=78{path}
#   Bunny Optimizer, ImageKit and most others: {url}?width={w}
IMAGE_CDN_RESIZE=
# Without IMAGE_CDN_URL, photos go through wsrv.nl (a free, open-source image CDN on Cloudflare: resized WebP, served
# near the buyer) whenever the site is on a public https address (PUBLIC_API_URL / SHOP_URL). IMAGE_CDN=off to stop that.
IMAGE_CDN=

# Routes along the actual roads on the rider's map (OpenStreetMap routing). Default: FOSSGIS's public OSRM server.
# OSM_ROUTER_URL=https://routing.openstreetmap.de/routed-car
# Maps: Leaflet with OpenStreetMap (no key). Addresses (suggestions, a pin's address, typed addresses) come from OpenStreetMap
# through this server (Photon + Nominatim, cached and rate-limited). For a busy live site, use a map-image provider:
#   MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
# Optional: your own Photon / Nominatim servers (defaults: the public ones)
# OSM_PHOTON_URL=https://photon.komoot.io
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Google (optional, server only): real road distances for delivery prices (Routes API). Without it distances are estimated.
# Google Maps Platform (addresses picked as people type, and real road distances for delivery prices)
# Browser key (Maps JavaScript API + Places API (New) + Geocoding API), restricted to your website. Can also be set in Admin -> Settings.
GOOGLE_MAPS_API_KEY=
# Server key (Places API (New) + Routes API), restricted to your server IP. Without it the browser key is used; without any key,
# suggestions come from our own pickup points and markets, and distances are estimated.
GOOGLE_MAPS_SERVER_KEY=

# Real photos for ads without one (npm run photos): a free Unsplash app
# https://unsplash.com/oauth/applications → New application → copy the "Access Key". Never commit it.
UNSPLASH_ACCESS_KEY=
