{
  "watch": [
    "server.js",
    "market",
    "config",
    "controllers",
    "middleware",
    "models",
    "routes",
    "utils",
    "security",
    ".env"
  ],
  "ext": "js,json",
  "ignore": [
    "uploads/**",
    "node_modules/**",
    "*.log",
    "*.tmp",
    "~$*"
  ],
  "delay": 1000
}
